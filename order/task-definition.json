{
  "family": "order-service-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::774489111931:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::774489111931:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "order-service",
      "image": "774489111931.dkr.ecr.ap-south-1.amazonaws.com/order-service",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8084,
          "hostPort": 8084,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "SERVER_PORT",
          "value": "8084"
        },
        {
          "name": "SPRING_APPLICATION_NAME",
          "value": "order"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager::774489111931:secret:order-service/db-password"
        },
        {
          "name": "API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:774489111931:secret:order-service/api-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/order",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --no-verbose --tries=1 --spider http://localhost:8084/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "mountPoints": [],
      "volumesFrom": []
    }
  ],
  "volumes": [],
  "placementConstraints": [],
  "tags": [
    {
      "key": "Environment",
      "value": "production"
    },
    {
      "key": "Service",
      "value": "order-service"
    },
    {
      "key": "Cluster",
      "value": "extroverted-crocodile-uufy4z"
    }
  ]
}